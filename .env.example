# ── Site ─────────────────────────────────────────────
# Public URL used for SEO (sitemap, Open Graph, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Restaurant contact numbers (international format without +, e.g. 923001234567).
# Leave empty until the real numbers are confirmed — buttons fall back to the contact page.
NEXT_PUBLIC_RESTAURANT_PHONE=
NEXT_PUBLIC_RESTAURANT_WHATSAPP=

# Shows small "demo content" notices for unconfirmed info (reviews, hours, ratings).
# Set to false once the restaurant confirms its real details.
NEXT_PUBLIC_SHOW_DEMO_NOTICE=true

# ── Supabase ─────────────────────────────────────────
# Leave both empty to run in DEMO MODE (data stored in the browser, demo admin login).
# Fill both to run in LIVE MODE backed by Supabase (Auth + Postgres + RLS + Storage).
# Only the anon (public) key belongs here. NEVER put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
